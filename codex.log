    /// The deterministic verifier command (P0-3 enforced).
    pub verify: &'a str,
    /// The verifier target dir.
    pub target: &'a Path,
    /// The worker workdir.
    pub workdir: &'a Path,
    /// Wall cap per attempt.
    pub wall_cap: Option<u64>,
    /// Idle cap per attempt, overriding the configured value.
    pub max_idle: Option<u64>,
